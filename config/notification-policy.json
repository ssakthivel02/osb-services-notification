{
  "apiVersion": "v1",
  "supportedLocales": ["en-GB", "ta"],
  "channels": ["email", "push", "sms", "inApp"],
  "authenticationRequired": true,
  "tenantIsolation": true,
  "idempotencyRequired": true,
  "consentRequiredForMarketing": true,
  "transactionalMessagesCannotBeSuppressed": true,
  "quietHoursSupported": true,
  "minorAccountsRequireGuardianControls": true,
  "templateVersioning": true,
  "piiMinimisation": true,
  "deliveryAuditRequired": true,
  "retry": {"maxAttempts": 5, "exponentialBackoff": true, "deadLetterQueue": true},
  "rateLimits": {"perUserPerMinute": 10, "perTenantPerMinute": 1000},
  "retentionDays": {"payload": 30, "deliveryMetadata": 365, "audit": 2555}
}
